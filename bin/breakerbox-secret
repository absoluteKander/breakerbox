#!/bin/bash
# breakerbox-secret — manage Breaker Box secrets and TLS pins.
#
#   breakerbox-secret set <ref>        store a secret in the keyring (prompted, never echoed)
#   breakerbox-secret check <ref>      say whether a secret exists (never prints it)
#   breakerbox-secret delete <ref>     remove it
#   breakerbox-secret pin <https-url>  print the sha256// pin for a self-signed server
#
# <ref> is the part after "keyring:" in config.json. Secrets live under
# service=breakerbox ref=<ref> in the Secret Service keyring
# (gnome-keyring / KWallet). For `pass:` references use `pass insert` instead.
set -euo pipefail

die() { echo "breakerbox-secret: $*" >&2; exit 1; }
valid_ref() { [[ $1 =~ ^[A-Za-z0-9._/@+-]+$ ]] || die "invalid ref '$1' (letters, digits, . _ / @ + -)"; }
need() { command -v "$1" >/dev/null || die "$1 is not installed${2:+ ($2)}"; }

cmd=${1:-}; arg=${2:-}
case $cmd in
  set)
    [[ -n $arg ]] || die "usage: breakerbox-secret set <ref>"; valid_ref "$arg"; need secret-tool "it comes with the libsecret package"
    read -r -s -p "Secret for $arg: " value; echo
    [[ -n $value ]] || die "empty secret, nothing stored"
    printf '%s' "$value" | secret-tool store --label="Breaker Box: $arg" service breakerbox ref "$arg"
    unset value
    echo "Stored. Use \"secret\": \"keyring:$arg\" in config.json."
    ;;
  check)
    [[ -n $arg ]] || die "usage: breakerbox-secret check <ref>"; valid_ref "$arg"; need secret-tool
    if secret-tool lookup service breakerbox ref "$arg" >/dev/null 2>&1; then echo "$arg: present"; else echo "$arg: missing"; exit 1; fi
    ;;
  delete)
    [[ -n $arg ]] || die "usage: breakerbox-secret delete <ref>"; valid_ref "$arg"; need secret-tool
    secret-tool clear service breakerbox ref "$arg" && echo "$arg: removed"
    ;;
  pin)
    [[ $arg =~ ^https://([^/:]+)(:([0-9]+))?(/.*)?$ ]] || die "usage: breakerbox-secret pin https://host[:port]"
    host=${BASH_REMATCH[1]}; port=${BASH_REMATCH[3]:-443}; need openssl
    key=$(openssl s_client -connect "$host:$port" -servername "$host" </dev/null 2>/dev/null | openssl x509 -pubkey -noout 2>/dev/null) \
      || die "couldn't read a certificate from $host:$port"
    pin=$(openssl pkey -pubin -outform der <<<"$key" | openssl dgst -sha256 -binary | base64)
    fp=$(openssl s_client -connect "$host:$port" -servername "$host" </dev/null 2>/dev/null | openssl x509 -noout -subject -fingerprint -sha256 2>/dev/null)
    echo "$fp"
    echo
    echo "Check that fingerprint against the server's own UI before trusting it, then add:"
    echo "  \"pin\": \"sha256//$pin\""
    echo
    echo "Only pin self-signed certs. A Let's Encrypt cert usually gets a new key on renewal, which would break the pin."
    ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; [[ -z $cmd || $cmd == -h || $cmd == --help ]] || exit 1 ;;
esac
